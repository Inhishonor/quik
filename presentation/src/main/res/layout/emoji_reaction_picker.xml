<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:layout_gravity="center">

    <LinearLayout
        android:id="@+id/dialog"
        android:layout_width="375dp"
        android:layout_height="350dp"
        android:orientation="vertical"
        android:padding="15dp"
        android:background="?android:attr/windowBackground"
        android:layout_gravity="center">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/emoji_thumbs_up"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="👍"
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emoji_thumbs_down"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="👎"
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emoji_laugh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="😂"
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emoji_surprised"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="😮"
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emoji_sad"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="😢"
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emoji_angry"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="😠"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emoji_heart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="❤️"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </HorizontalScrollView>

        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker_full"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="visible" />

    </LinearLayout>
</FrameLayout>
